# ---- 공통 ----
APP_ENV=dev                       # dev | prod
LOG_LEVEL=INFO
USER_AGENT=bitchord-flac-gateway/1.0 (contact: you@example.com)
CORS_ORIGINS=*                    # 쉼표 구분. prod에서는 실제 도메인으로 제한

# ---- BitChord 애드온 설정 ----
ADDON_ID=com.bitchord.flac.gateway
ADDON_NAME=BitChord Hybrid FLAC Gateway
# 비워두면 루트(/manifest.json)로 동작, 값을 넣으면 /<secret>/manifest.json 경로로 보호
ADDON_PATH_SECRET=
# 트랙 ID 및 스트림 토큰 서명 키 (prod에서는 반드시 긴 랜덤 문자열로 설정)
SIGNING_SECRET=change-me-in-production
# true면 게이트웨이가 /audio/{token}으로 HTTP 206 Range 프록시(업스트림 키/URL 은닉)
PROXY_STREAM=true
PLAY_TOKEN_TTL=21600              # 6시간

# ---- 폴백 체인 (앞에서부터 순서대로 시도) ----
DEFAULT_CHAIN=public_lossless,subsonic
# 요청 옵션 없이도 항상 체인 뒤에 붙일 추가 소스 (비워두면 ?include=custom 으로만 활성화)
AUTO_EXTRA_SOURCES=

# ---- 타임아웃/재시도 (초) ----
CONNECT_TIMEOUT=2.0
READ_TIMEOUT=5.0
STREAM_READ_TIMEOUT=30.0
TOTAL_DEADLINE=10.0               # 검색 요청 1건이 쓸 수 있는 전체 예산
MAX_RETRIES=1                     # 소스당 재시도 횟수 (타임아웃/5xx/네트워크 오류만)
RETRY_BACKOFF=0.3

# ---- 서킷 브레이커 ----
CB_FAILURE_THRESHOLD=3            # 연속 실패 N회면 오픈
CB_COOLDOWN=30                    # 오픈 유지 시간(초)

# ---- 조회 제한 ----
DEFAULT_LIMIT=10
MAX_LIMIT=40

# ---- 공개/커뮤니티 무손실 API 소스 (선택) ----
PUBLIC_LOSSLESS_BASE_URL=

# ---- 셀프호스팅 Subsonic / Navidrome 소스 (선택) ----
SUBSONIC_BASE_URL=
SUBSONIC_USER=
SUBSONIC_PASSWORD=

# ---- 셀프호스팅 Jellyfin 소스 (선택) ----
JELLYFIN_BASE_URL=
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=

# ---- Mornye-Extension 호환 hifi-api 규격 소스 (선택: /track/?id=...&quality=...) ----
HIFI_API_BASE_URL=
HIFI_API_KEY=

# ---- Mornye-Extension 호환 qobuz-rest-api 규격 소스 (선택: /download-url/{id}?quality=...) ----
QOBUZ_REST_BASE_URL=
QOBUZ_REST_API_KEY=

# ---- 선택/유료 커스텀 FLAC API 소스 ----
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_KEY_HEADER=X-API-Key

# ---- Mornye-Python 백엔드 (선택) ----
# 켜면 이 저장소의 Mornye가 검색/ISRC 조회를 맡고, 재생 요청 시 Mornye에 설치된
# 확장(extension)으로 곡을 받아 FLAC로 변환 -> 캐시 -> /audio/{token}(Range)로 제공합니다.
# 소스 이름은 "mornye" 이며 DEFAULT_CHAIN 에 넣어야 사용됩니다 (예: DEFAULT_CHAIN=mornye,subsonic).
# 확장/레지스트리는 Mornye 자체 설정(MORNYE_REGISTRIES, 확장 설치)을 따릅니다. 기본 제공 소스는 없습니다.
MORNYE_BACKEND_ENABLED=false
# 쉼표 구분 Mornye 서비스(예: ext:tidal-web). 비우면 Mornye 기본값 사용
MORNYE_BACKEND_SERVICES=
# 받은 파일 캐시 위치와 용량 상한(MB, 오래된 것부터 삭제)
MORNYE_BACKEND_CACHE_DIR=
MORNYE_BACKEND_CACHE_MAX_MB=4096
# /stream 요청 1건이 곡 다운로드를 기다리는 최대 시간(초)
MORNYE_BACKEND_STREAM_TIMEOUT=180
