# Sourced by termux/start.sh (so $HOME works). Copy to ~/.bitchord/gateway.env.
APP_ENV=prod
LOG_LEVEL=INFO
# 127.0.0.1: only apps on this phone can reach it (safe on public Wi-Fi/cellular).
# 0.0.0.0: reachable from other devices on your network.
HOST=127.0.0.1
PORT=8000
WEB_CONCURRENCY=1
SIGNING_SECRET=__GENERATED_BY_INSTALL__
# CORS_ORIGINS=*

DEFAULT_CHAIN=mornye
MORNYE_BACKEND_ENABLED=true
# e.g. ext:tidal-web — what is available depends on the extensions you installed in Mornye
MORNYE_BACKEND_SERVICES=
MORNYE_BACKEND_CACHE_DIR="$HOME/.bitchord/cache"
# Phone storage is small: keep the cache modest (MB).
MORNYE_BACKEND_CACHE_MAX_MB=1024
# A phone on mobile data downloads slowly; give the first play longer.
MORNYE_BACKEND_STREAM_TIMEOUT=300

# Searches go through Mornye's metadata client, which is slower than a plain proxy.
CONNECT_TIMEOUT=3.0
READ_TIMEOUT=12.0
TOTAL_DEADLINE=25.0
